options {
    STATIC = false;
    MULTI = true;       
    VISITOR = true;
    NODE_DEFAULT_VOID = false;
}

PARSER_BEGIN(JavaCompiler)

import java.io.*;
import java.util.HashMap;
import java.util.Map;
import java.util.Stack;

class SymbolEntry {
    String type;
    int usageCount = 0;
    
    public SymbolEntry(String type) {
        this.type = type;
    }
    public void markUsed() {
        this.usageCount++; 
    }
    @Override
    public String toString() {
        return type;
    }
}

public class JavaCompiler { 
    
    public static Stack<Map<String, SymbolEntry>> scopeStack = new Stack<Map<String, SymbolEntry>>(); 
    public static SimpleNode astRoot = null;

    public static void initializeScope() {
        scopeStack.push(new HashMap<String, SymbolEntry>()); 
    }
    
    public static SymbolEntry findSymbol(String name) {
        for (int i = scopeStack.size() - 1; i >= 0; i--) {
            Map<String, SymbolEntry> currentScope = scopeStack.get(i);
            if (currentScope.containsKey(name)) {
                return currentScope.get(name);
            }
        }
        return null;
    }

    // --- Helper to Categorize Tokens (Phase 1 Output) ---
    public static String getCategory(int kind) {
        switch (kind) {
            case CLASS: case PUBLIC: case STATIC: case VOID: case MAIN:
            case INT: case BOOLEAN: case STRING: case IF: case ELSE:
            case WHILE: case FOR: case RETURN: case PRINT:
                return "Keyword";
            case IDENTIFIER: return "Identifier";
            case INTEGER_LITERAL: return "Numeric Constant";
            case STRING_LITERAL: return "String Constant";
            case BOOLEAN_LITERAL: return "Boolean Constant";
            case PLUS: case MINUS: case MULTIPLY: case DIVIDE: case ASSIGN:
            case EQ: case NE: case GT: case LT: case GE: case LE:
                return "Operator";
            default: return "Symbol";
        }
    }

    // --- Custom Pretty Printer for AST ---
    public static void printPrettyTree(SimpleNode node, String prefix, boolean isTail) {
        String nodeName = node.toString();
        String value = (node.jjtGetValue() != null) ? node.jjtGetValue().toString() : "";
        String details = "";

        // Mapping internal names to your desired display names
        if (nodeName.equals("Start")) nodeName = "CompilationUnit";
        else if (nodeName.equals("ClassDeclaration")) {
            nodeName = "TypeDeclaration";
            details = "(name: " + value + ", modifier: public)";
        }
        else if (nodeName.equals("MainMethod")) {
            nodeName = "MethodDeclaration";
            details = "(name: main, modifiers: public static, return type: void)";
        }
        else if (nodeName.equals("Block")) {
            nodeName = "Block";
            details = "";
        }
        else if (nodeName.equals("VariableDeclaration")) {
            nodeName = "VariableDeclarationStatement";
            if (value.contains(":")) {
                String[] parts = value.split(":");
                details = "(type: " + parts[1] + ", name: " + parts[0] + ")";
            } else {
                 details = "(name: " + value + ")";
            }
        }
        else if (nodeName.equals("Assignment")) {
            nodeName = "ExpressionStatement"; // Assignment is an expression statement
            if (value.contains(":")) {
                 String[] parts = value.split(":");
                 details = "(Assignment: " + parts[0] + ")";
            }
        }
        else if (nodeName.equals("Expression")) {
             nodeName = "InfixExpression";
             details = value; 
        }
        else if (nodeName.equals("AdditiveExpression") || nodeName.equals("MultiplicativeExpression")) {
            nodeName = "InfixExpression";
            details = value; 
        }
        else if (nodeName.equals("Identifier")) {
            nodeName = "SimpleName";
            if (value.contains(":")) value = value.split(":")[0];
            details = "(" + value + ")";
        }
        else if (nodeName.equals("Literal")) {
            if (value.startsWith("\"")) nodeName = "StringLiteral";
            else if (value.equals("true") || value.equals("false")) nodeName = "BooleanLiteral";
            else nodeName = "NumberLiteral";
            details = "(" + value + ")";
        }
        else if (nodeName.equals("IfStatement")) {
             nodeName = "IfStatement";
        }
        else if (nodeName.equals("PrintStatement")) {
            nodeName = "ExpressionStatement";
            details = "[System.out.println]";
        }
        else if (nodeName.equals("ReturnStatement")) {
            nodeName = "ReturnStatement";
        }

        // Print the node
        System.out.println(prefix + (isTail ? "└── " : "├── ") + nodeName + " " + details);

        // Calculate prefix for children
        for (int i = 0; i < node.jjtGetNumChildren(); i++) {
            boolean isLast = (i == node.jjtGetNumChildren() - 1);
            printPrettyTree((SimpleNode) node.jjtGetChild(i), prefix + (isTail ? "    " : "│   "), isLast);
        }
    }
    
    public static void main(String[] args) {
        try {
            String content = "";
            if (args.length == 1) {
                File file = new File(args[0]);
                BufferedReader br = new BufferedReader(new FileReader(file));
                StringBuilder sb = new StringBuilder();
                String line;
                while ((line = br.readLine()) != null) {
                    sb.append(line).append("\n");
                }
                br.close();
                content = sb.toString();
            } else {
                System.out.println("Usage: java JavaCompiler <input_file>");
                return;
            }

            // PHASE 1: Symbol Table
            System.out.println("\n--- Symbol Table (Tokens) ---");
            StringReader sr1 = new StringReader(content);
            JavaCompiler lexer = new JavaCompiler(sr1);
            Token t = lexer.getNextToken();
            while (t.kind != EOF) {
                if (t.kind != 0) System.out.println(getCategory(t.kind) + " (" + t.image + ")");
                t = lexer.getNextToken();
            }
            System.out.println("-----------------------------\n");

            // PHASE 2 & 3: Syntax & AST
            System.out.println("--- Syntax & AST Check ---");
            StringReader sr2 = new StringReader(content);
            JavaCompiler parser = new JavaCompiler(sr2); 
            initializeScope();

            try {
                SimpleNode root = parser.Start(); 
                System.out.println("✅ Syntax Validation Successful.");
                
                if (root != null) {
                    System.out.println("\n--- Abstract Syntax Tree (AST) ---");
                    printPrettyTree(root, "", true);
                    System.out.println("----------------------------------");
                }

            } catch (ParseException e) {
                System.out.println("❌ Syntax Error: " + e.getMessage());
            }

        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}

PARSER_END(JavaCompiler)

SKIP : { " " | "\t" | "\n" | "\r" | <"//" (~["\n","\r"])* ("\n"|"\r"|"\r\n")> | <"/*" (~["*"])* "*" ("*" | (~["*","/"] (~["*"])* "*"))* "/"> }

TOKEN :
{
  < INT: "int" > | < BOOLEAN: "boolean" > | < STRING: "String" >
| < CLASS: "class" > | < PUBLIC: "public" > | < STATIC: "static" > | < VOID: "void" >
| < MAIN: "main" > | < IF: "if" > | < ELSE: "else" > | < WHILE: "while" > | < FOR: "for" > 
| < PRINT: "System.out.println" > | < RETURN: "return" > 
| < ASSIGN: "=" > | < PLUS: "+" > | < MINUS: "-" > | < MULTIPLY: "*" > | < DIVIDE: "/" >
| < LT: "<" > | < GT: ">" > | < LE: "<=" > | < GE: ">=" > | < EQ: "==" > | < NE: "!=" >
| < SEMICOLON: ";" > | < COMMA: "," > | < DOT: "." >
| < LBRACE: "{" > | < RBRACE: "}" > | < LBRACKET: "[" > | < RBRACKET: "]" > | < LPAREN: "(" > | < RPAREN: ")" >
| < IDENTIFIER: (["a"-"z","A"-"Z","_","$"]) (["a"-"z","A"-"Z","_","$","0"-"9"])* >
| < INTEGER_LITERAL: (["1"-"9"] (["0"-"9"])*) | "0" >
| < STRING_LITERAL: "\"" (~["\""])* "\"" >
| < BOOLEAN_LITERAL: "true" | "false" >
}

String Type() : { String typeName; }
{
    ( <INT> { typeName = "int"; } | <BOOLEAN> { typeName = "boolean"; } | <STRING> { typeName = "String"; } )
    { return typeName; }
}

void Literal() : {}
{
    <INTEGER_LITERAL> { jjtThis.jjtSetValue(token.image); }
  | <STRING_LITERAL> { jjtThis.jjtSetValue(token.image); }
  | <BOOLEAN_LITERAL> { jjtThis.jjtSetValue(token.image); }
}

SimpleNode Start() : {}
{
    ClassDeclaration() <EOF>
    { return jjtThis; } // <--- هنا كان الخطأ، ضفت السطر ده عشان يرجع النود
}

void ClassDeclaration() : { Token t; }
{
    <PUBLIC> <CLASS> t = <IDENTIFIER> 
    { 
        scopeStack.push(new HashMap<String, SymbolEntry>()); 
        jjtThis.jjtSetValue(t.image);
    }
    <LBRACE> MainMethod() <RBRACE>
    { scopeStack.pop(); }
}

void MainMethod() : { Token t; }
{
    <PUBLIC> <STATIC> <VOID> <MAIN> 
    <LPAREN> <STRING> <LBRACKET> <RBRACKET> t = <IDENTIFIER> 
    { 
        scopeStack.push(new HashMap<String, SymbolEntry>()); 
        scopeStack.peek().put(t.image, new SymbolEntry("String[]")); 
    }
    <RPAREN> Block() { scopeStack.pop(); }
}

void Block() : {}
{
    <LBRACE>
    { scopeStack.push(new HashMap<String, SymbolEntry>()); }
    ( Statement() )*
    <RBRACE>
    { scopeStack.pop(); }
}

void Statement() : {}
{
      ( VariableDeclaration() <SEMICOLON> )
    | ( Assignment() <SEMICOLON> )
    | Block()
    | IfStatement()
    | WhileStatement()
    | ForStatement()
    | ( PrintStatement() <SEMICOLON> )
    | ReturnStatement() 
}

void VariableDeclaration() : { Token t; String varType; }
{
    varType = Type()
    t = <IDENTIFIER>
    {
        Map<String, SymbolEntry> currentScope = scopeStack.peek();
        currentScope.put(t.image, new SymbolEntry(varType));
        jjtThis.jjtSetValue(t.image + ":" + varType);
    }
    ( <ASSIGN> Expression() )?
}

void Assignment() : { Token t; SymbolEntry entry; }
{
    t = <IDENTIFIER>
    {
        entry = findSymbol(t.image);
        if (entry != null) entry.markUsed();
        jjtThis.jjtSetValue(t.image + ":" + (entry!=null?entry.type:"unknown"));
    }
    <ASSIGN> Expression()
}

void ReturnStatement() : {}
{
    <RETURN> (Expression())? <SEMICOLON>
}

void IfStatement() : {}
{
    <IF> <LPAREN> Expression() <RPAREN> Statement() 
    ( <ELSE> Statement() )?
}

void WhileStatement() : {}
{
    <WHILE> <LPAREN> Expression() <RPAREN> Statement()
}

void ForStatement() : {}
{
    <FOR> <LPAREN>
        ( VariableDeclaration() | Assignment() )? <SEMICOLON>
        ( Expression() )? <SEMICOLON>
        ( Assignment() | Expression() )?
    <RPAREN>
    Statement()
}

void PrintStatement() : {}
{
    <PRINT> <LPAREN> Expression() <RPAREN>
}

void Expression() : { Token op=null; }
{
    AdditiveExpression()
    ( 
      ( op=<LT> | op=<GT> | op=<LE> | op=<GE> | op=<EQ> | op=<NE> ) 
      AdditiveExpression() 
      { jjtThis.jjtSetValue("operator: " + op.image); }
    )*
}

void AdditiveExpression() : { Token op=null; }
{
    MultiplicativeExpression()
    ( 
      ( op=<PLUS> | op=<MINUS> ) 
      MultiplicativeExpression() 
      { jjtThis.jjtSetValue("operator: " + op.image); }
    )*
}

void MultiplicativeExpression() : { Token op=null; }
{
    PrimaryExpression()
    ( 
      ( op=<MULTIPLY> | op=<DIVIDE> ) 
      PrimaryExpression() 
      { jjtThis.jjtSetValue("operator: " + op.image); }
    )*
}

void PrimaryExpression() : {}
{
      Literal()
    | Identifier() 
    | <LPAREN> Expression() <RPAREN> 
}

void Identifier() : {}
{
    <IDENTIFIER>
    {
        SymbolEntry entry = findSymbol(token.image);
        if (entry != null) {
            entry.markUsed();
            jjtThis.jjtSetValue(token.image + ":" + entry.type); 
        } else {
             jjtThis.jjtSetValue(token.image + ":unknown"); 
        }
    }
}