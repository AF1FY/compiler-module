options {
  STATIC = false; // Allows multiple instances (Symbol Table + Parser)
}

PARSER_BEGIN(JavaCompiler)

import java.io.*;

public class JavaCompiler {
  
  // Helper method to categorize tokens for the Symbol Table
  public static String getCategory(int kind) {
    switch (kind) {
      // Keywords
      case CLASS: case PUBLIC: case STATIC: case VOID: case MAIN:
      case INT: case BOOLEAN: case STRING: case IF: case ELSE:
      case WHILE: case RETURN: case PRINT:
        return "Keyword";
        
      // Identifiers
      case IDENTIFIER:
        return "Identifier";
        
      // Constants
      case INTEGER_LITERAL:
        return "Numeric Constant";
      case STRING_LITERAL:
        return "String Constant";
      case BOOLEAN_LITERAL:
        return "Boolean Constant";
        
      // Operators
      case PLUS: case MINUS: case MULTIPLY: case DIVIDE: case ASSIGN:
      case EQ: case NE: case GT: case LT: case GE: case LE:
        return "Operator";
        
      // Special Characters / Delimiters
      case LPAREN: case RPAREN: case LBRACE: case RBRACE:
      case LBRACKET: case RBRACKET: case SEMICOLON: case COMMA: case DOT:
        return "Special Character";
        
      default:
        return "Unknown";
    }
  }

  public static void main(String[] args) {
    try {
      // 1. Determine input source (File or Console)
      InputStream input = null;
      if (args.length > 0) {
        input = new FileInputStream(args[0]);
        System.out.println("Processing file: " + args[0]);
      } else {
        System.out.println("Enter code directly (or run with file path as argument):");
        input = System.in;
      }

      // Read input into a memory buffer
      ByteArrayOutputStream buffer = new ByteArrayOutputStream();
      byte[] data = new byte[1024];
      int nRead;
      while ((nRead = input.read(data, 0, data.length)) != -1) {
        buffer.write(data, 0, nRead);
      }
      buffer.flush();
      byte[] sourceBytes = buffer.toByteArray();

      // ==========================================
      // Step 1: Symbol Table Generation (Formatted)
      // ==========================================
      System.out.println("\n--- Symbol Table ---");
      // Header is not strictly needed per example, but good for organization
      // We will print exactly as requested: Category (Value)
      
      ByteArrayInputStream streamForTokens = new ByteArrayInputStream(sourceBytes);
      SimpleCharStream charStream = new SimpleCharStream(streamForTokens);
      JavaCompilerTokenManager tokenMgr = new JavaCompilerTokenManager(charStream);
      Token t = tokenMgr.getNextToken();
      
      while (t.kind != EOF) {
        String category = getCategory(t.kind);
        
        // Format: Category (Value)
        // Example: Identifier (sum)
        System.out.println(category + " (" + t.image + ")");
        
        t = tokenMgr.getNextToken();
      }
      System.out.println("--------------------\n");

      // ==========================================
      // Step 2: Syntax Analysis (Phase 2 Output)
      // ==========================================
      System.out.println("--- Syntax Validation ---");
      ByteArrayInputStream streamForParser = new ByteArrayInputStream(sourceBytes);
      JavaCompiler parser = new JavaCompiler(streamForParser);
      
      try {
        parser.Start();
        System.out.println("✅ Syntax validation successful. Code is valid Java.");
      } catch (ParseException e) {
        System.out.println("❌ Syntax Error: " + e.getMessage());
      }

    } catch (Exception e) {
      System.out.println("Error: " + e.getMessage());
      e.printStackTrace();
    }
  }
}

PARSER_END(JavaCompiler)

/* ==================================================================== */
/* 1. SKIP RULES */
/* ==================================================================== */
SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
| <SINGLE_LINE_COMMENT: "//" (~["\n","\r"])* ("\n"|"\r"|"\r\n")>
| <MULTI_LINE_COMMENT: "/*" (~["*"])* "*" ("*" | (~["*","/"] (~["*"])* "*"))* "/">
}

/* ==================================================================== */
/* 2. TOKEN RULES */
/* ==================================================================== */

/* Keywords */
TOKEN :
{
  < CLASS: "class" >
| < PUBLIC: "public" >
| < STATIC: "static" >
| < VOID: "void" >
| < MAIN: "main" >
| < STRING: "String" >
| < INT: "int" >
| < BOOLEAN: "boolean" >
| < IF: "if" >
| < ELSE: "else" >
| < WHILE: "while" >
| < RETURN: "return" >
| < PRINT: "System.out.println" > 
}

/* Literals & Identifiers */
TOKEN :
{
  < INTEGER_LITERAL: (["0"-"9"])+ >
| < STRING_LITERAL: "\"" (~["\""])* "\"" > 
| < BOOLEAN_LITERAL: "true" | "false" >
| < IDENTIFIER: ["a"-"z","A"-"Z","_"] (["a"-"z","A"-"Z","0"-"9","_"])* >
}

/* Separators & Operators */
TOKEN :
{
  < LPAREN: "(" >
| < RPAREN: ")" >
| < LBRACE: "{" >
| < RBRACE: "}" >
| < LBRACKET: "[" >
| < RBRACKET: "]" >
| < SEMICOLON: ";" >
| < COMMA: "," >
| < DOT: "." >
| < ASSIGN: "=" >
| < LT: "<" >
| < GT: ">" >
| < EQ: "==" >
| < LE: "<=" >
| < GE: ">=" >
| < NE: "!=" >
| < PLUS: "+" >
| < MINUS: "-" >
| < MULTIPLY: "*" >
| < DIVIDE: "/" >
}

/* ==================================================================== */
/* 3. GRAMMAR RULES */
/* ==================================================================== */

void Type() :
{}
{
  <INT> | <BOOLEAN> | <STRING>
}

void Literal() :
{}
{
  <INTEGER_LITERAL> | <STRING_LITERAL> | <BOOLEAN_LITERAL>
}

/* --- Program Structure --- */

void Start() :
{}
{
  ClassDeclaration() <EOF>
}

void ClassDeclaration() :
{}
{
  <CLASS> <IDENTIFIER> <LBRACE>
  ( MainMethod() )* <RBRACE>
}

void MainMethod() :
{}
{
  <PUBLIC> <STATIC> <VOID> <MAIN> 
  <LPAREN> <STRING> <LBRACKET> <RBRACKET> <IDENTIFIER> <RPAREN>
  <LBRACE>
    ( Statement() )* <RBRACE>
}

/* --- Statements --- */

void Statement() :
{}
{
  (
    LOOKAHEAD(2) 
    VariableDeclaration() 
  |
    Assignment()
  |
    Block()
  |
    IfStatement()
  |
    WhileStatement()
  |
    PrintStatement()
  )
}

void Block() :
{}
{
  <LBRACE> ( Statement() )* <RBRACE>
}

void VariableDeclaration() :
{}
{
  Type() <IDENTIFIER> ( <ASSIGN> Expression() )? <SEMICOLON>
}

void Assignment() :
{}
{
  <IDENTIFIER> <ASSIGN> Expression() <SEMICOLON>
}

void IfStatement() :
{}
{
  <IF> <LPAREN> Expression() <RPAREN> Statement() 
  ( LOOKAHEAD(1) <ELSE> Statement() )? 
}

void WhileStatement() :
{}
{
  <WHILE> <LPAREN> Expression() <RPAREN> Statement()
}

void PrintStatement() :
{}
{
  <PRINT> <LPAREN> Expression() <RPAREN> <SEMICOLON>
}

/* --- Expressions --- */

void Expression() :
{}
{
  AdditiveExpression() 
  ( 
    ( <LT> | <GT> | <LE> | <GE> | <EQ> | <NE> ) 
    AdditiveExpression() 
  )*
}

void AdditiveExpression() :
{}
{
  MultiplicativeExpression() 
  ( ( <PLUS> | <MINUS> ) MultiplicativeExpression() )*
}

void MultiplicativeExpression() :
{}
{
  PrimaryExpression() 
  ( ( <MULTIPLY> | <DIVIDE> ) PrimaryExpression() )*
}

void PrimaryExpression() :
{}
{
  Literal() 
| <IDENTIFIER>
| <LPAREN> Expression() <RPAREN> 
}